# Copy to .env and fill in. Names only here; never commit values.
# One model key is enough. Order tried: Gemini, OpenAI, Azure OpenAI.
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=

# Optional. Model names (defaults: gemini-3.8-flash, gpt-4o-mini, Azure deployment gpt-5-mini).
TAN_GEMINI_MODEL=
TAN_OPENAI_MODEL=
TAN_AZURE_DEPLOYMENT=

# Optional partner tools. Each one runs simulated (and says so) when its key is absent.
DIAL_API_KEY=
DIAL_FROM_NUMBER=
DEMO_TO_NUMBER=
DIAL_WEBHOOK_SECRET=
DARWIN_API_KEY=
